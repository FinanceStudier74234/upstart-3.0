# ============================================================
# UPST Master Quant Finance Hub — Environment Configuration
# ============================================================
# Copy to .env and fill in your keys.

# ── Core App ──
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=change-me-to-random-secret
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Database ──
DATABASE_URL=postgresql+asyncpg://upst:upst@localhost:5432/upst_hub
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20

# ── Redis (cache / pubsub / rate-limit) ──
REDIS_URL=redis://localhost:6379/0

# ── Market Data Providers ──
# Polygon.io (primary equity + options data)
POLYGON_API_KEY=
POLYGON_PLAN=basic          # basic | starter | developer | advanced

# Alpha Vantage (fallback + macro)
ALPHA_VANTAGE_API_KEY=

# FRED (macro / rates / credit)
FRED_API_KEY=

# Finnhub (news + sentiment + filings)
FINNHUB_API_KEY=

# Yahoo Finance (free fallback — no key needed)
# Used automatically as lowest-priority fallback.

# ── Options Data ──
# Tradier (options chains + greeks)
TRADIER_API_KEY=
TRADIER_SANDBOX=true

# CBOE (VIX data — public endpoint, no key)

# ── Short Data ──
# ORTEX (institutional short/borrow data — if available)
ORTEX_API_KEY=

# Fintel (short data fallback)
FINTEL_API_KEY=

# ── News / Sentiment ──
# NewsAPI
NEWSAPI_KEY=

# ── SEC / EDGAR ──
SEC_EDGAR_USER_AGENT=your-email@example.com

# ── News Intelligence ──
NEWS_INTELLIGENCE_ENABLED=true
NEWS_INTELLIGENCE_CACHE_TTL=300
NEWS_INTELLIGENCE_MAX_SOURCES=10
NEWS_INTELLIGENCE_FETCH_TIMEOUT=30
NEWS_INTELLIGENCE_REFRESH_SECONDS=600

# ── Scheduling ──
SCHEDULER_ENABLED=true
MARKET_DATA_REFRESH_SECONDS=60
OPTIONS_DATA_REFRESH_SECONDS=300
MACRO_DATA_REFRESH_SECONDS=3600
NEWS_REFRESH_SECONDS=600
SHORT_DATA_REFRESH_SECONDS=1800

# ── Advanced Engine Config ──
# GARCH/HMM/Kalman engines run automatically when data is available.
# No additional keys needed — they compute from price data.

# ── Polygon WebSocket Streaming (real-time) ──
# Requires Polygon starter+ plan. Channels: T.UPST (trades), Q.UPST (quotes),
# AM.UPST (minute aggs), T.SPY, AM.SPY
# POLYGON_STREAMING_ENABLED=false
# POLYGON_STREAMING_CHANNELS=T.UPST,Q.UPST,AM.UPST,T.SPY,AM.SPY

# ── Frontend ──
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── Mock Mode ──
# Set to true to run entirely on generated mock data (no API keys needed)
MOCK_MODE=false

# ============================================================
#  UPST Quant Finance Hub v3.0 — Configuration
# ============================================================


# ████████████████████████████████████████████████████████████
#
#   YOUR API KEYS — PASTE THEM HERE FOR LIVE MARKET DATA
#
#   Without keys the app runs on demo/fallback data.
#   Add any key below and restart to get real data from
#   that provider. You don't need all of them — even one
#   key (like Polygon free tier) will pull live prices.
#
# ████████████████████████████████████████████████████████████

# 1) POLYGON.IO — Real-time & historical stock + options data
#    Free tier: https://polygon.io/pricing  (sign up, paste key)
#    Plans: "basic" (free, 5 calls/min), "starter", "developer", "advanced"
POLYGON_API_KEY=
POLYGON_PLAN=basic

# 2) FRED — Federal Reserve macro data (GDP, CPI, yields, unemployment)
#    Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 3) ALPHA VANTAGE — Stock quotes, fundamentals, technicals
#    Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# 4) FINNHUB — Real-time quotes, company news, SEC filings
#    Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# 5) TRADIER — Options chain data (sandbox is free)
#    Sign up: https://developer.tradier.com/
#    Set TRADIER_SANDBOX=false when using a live account
TRADIER_API_KEY=
TRADIER_SANDBOX=true

# 6) NEWSAPI — Breaking news headlines & sentiment
#    Free key: https://newsapi.org/register
NEWSAPI_KEY=

# 7) ORTEX — Short interest & institutional flow (paid)
#    https://www.ortex.com/
ORTEX_API_KEY=

# 8) FINTEL — Short squeeze & insider data (paid)
#    https://fintel.io/
FINTEL_API_KEY=

# 9) SEC EDGAR — SEC filings & insider trades (free, just needs an email)
#    Put any valid email — SEC requires it as a user-agent identifier
SEC_EDGAR_USER_AGENT=your-email@example.com

# ████████████████████████████████████████████████████████████
#   END OF API KEYS — Everything below is app configuration
#   (you probably don't need to change anything below)
# ████████████████████████████████████████████████████████████


# ── Core App ──
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=dev-only-not-for-production
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Database (SQLite for local dev — no Postgres required) ──
DATABASE_URL=sqlite+aiosqlite:///./upst_hub.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# ── Redis (optional in dev) ──
REDIS_URL=redis://localhost:6379/0

# ── News Intelligence ──
NEWS_INTELLIGENCE_ENABLED=true
NEWS_INTELLIGENCE_CACHE_TTL=300
NEWS_INTELLIGENCE_MAX_SOURCES=10
NEWS_INTELLIGENCE_FETCH_TIMEOUT=30
NEWS_INTELLIGENCE_REFRESH_SECONDS=600

# ── Scheduling ──
SCHEDULER_ENABLED=true
MARKET_DATA_REFRESH_SECONDS=60
OPTIONS_DATA_REFRESH_SECONDS=300
MACRO_DATA_REFRESH_SECONDS=3600
NEWS_REFRESH_SECONDS=600
SHORT_DATA_REFRESH_SECONDS=1800

# ── Mock Mode (set true to skip all real API calls) ──
MOCK_MODE=false

# ── Frontend ──
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
